# --- Виртуальное окружение и кэш Python ---
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Данные и видео проекта ---
# Игнорируем всё внутри data/, но оставляем саму структуру папок
data/*
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/**/.gitkeep

# --- Веса нейросетей и модели ---
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx
*.engine

# --- Временные файлы и медиа ---
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
runs/

# --- Среды разработки (IDE) и ОС ---
.vscode/
.idea/
.DS_Store
Thumbs.db
